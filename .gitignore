# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
*.env
.envrc

# vercel and other deploy tooling state
.vercel
.netlify
.modal.toml

# keys and credentials
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.keystore
credentials.json
service-account*.json
.npmrc

# python (scripts/)
__pycache__/
*.pyc
.venv/
venv/

# editors
.idea/
.vscode/

# typescript
*.tsbuildinfo
next-env.d.ts
